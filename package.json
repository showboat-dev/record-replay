{
  "name": "rr",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "site": "tsx fixtures/site/server.ts",
    "rr": "tsx packages/cli/src/main.ts",
    "harness": "tsx packages/harness/src/cli.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm lint",
    "lint": "eslint packages fixtures --no-warn-ignored",
    "format": "prettier --write \"packages/**/*.ts\" \"fixtures/**/*.{ts,js,html,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "playwright": "1.64.1",
    "zod": "^3.24.1"
  }
}
